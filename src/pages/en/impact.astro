---
import Base from "../../layouts/Base.astro";
import ImpactBar from "../../components/ImpactBar.astro";
import ImpactMatrix from "../../components/ImpactMatrix.astro";
import ImpactSection from "../../components/ImpactSection.astro";
import FollowupTables from "../../components/FollowupTables.astro";
import ImpactReferences from "../../components/ImpactReferences.astro";
import {
  detectionData,
  testsData,
  referralsData,
  hospitalData,
} from "../../data/impact-data";

const columnLabels = {
  name: "Event",
  rr: "RR (95% CI)",
  observed: "Observed",
  delta: "Δ",
  newValue: "New",
};
const locale = "en-US" as const;
const collapseLabel = "Show less";
---

<Base
  lang="en"
  title="Impact · family-medicine-impact"
  description="What two years of training in Family Medicine do to medical practice in primary care. Evidence from two cohorts in Rio de Janeiro."
>
  <section
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 pt-12 pb-8 md:pt-16 md:pb-10"
  >
    <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-accent mb-3">
      IMPACT
    </p>
    <h1
      class="text-3xl md:text-4xl lg:text-5xl font-semibold tracking-[-0.035em] text-slate-900 dark:text-slate-100 mb-4"
    >
      What two years of training in Family Medicine do to medical practice in
      primary care.
    </h1>
    <p class="text-base md:text-lg font-medium text-accent">
      Evidence from 600,000 patients followed for 6 years in primary care in
      Rio de Janeiro, attended by family physicians and by generalist
      physicians (physicians without family-medicine training).
    </p>
  </section>

  <section
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 mb-10 md:mb-14 space-y-4 text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300"
  >
    <p>
      The data presented here come from a cohort of 600,000 patients followed
      in primary care in Rio de Janeiro between 2013 and 2018. Patients were
      seen by two distinct groups of physicians: family physicians with 2
      years of residency training in the specialty (200,000 patients) versus
      physicians without this training (400,000 patients). Working conditions
      and the demographic profile of the populations served were the same;
      the only difference was the physicians' training.
    </p>
    <p>
      The numbers below reflect what happened in that cohort. Use the bar
      below to project what would happen to condition detection, to lab test
      ordering, to referrals to secondary care, and to hospital admissions if
      the proportion of family physicians were higher — or lower.
    </p>
  </section>

  <ImpactBar
    labels={{
      generalists: "Generalists",
      familyPhysicians: "Family physicians",
      instruction: "Drag to simulate scenarios",
      reset: "Reset",
    }}
  />

  <section
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 mt-8 md:mt-10 mb-12 md:mb-16"
  >
    <ImpactMatrix
      labels={{
        detection: {
          number: "01",
          title: "DETECTION",
          caption: "chronic conditions / year",
        },
        tests: {
          number: "02",
          title: "TESTS",
          caption: "lab tests / year",
        },
        referrals: {
          number: "03",
          title: "REFERRALS",
          caption: "referrals / year (net)",
        },
        hospital: {
          number: "04",
          title: "ADMISSIONS",
          caption: "hospital admissions / year",
        },
      }}
    />
  </section>

  <section
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 mb-12 md:mb-16"
  >
    <nav
      class="border-t-[0.5px] border-b-[0.5px] border-slate-200 dark:border-slate-700 py-4"
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <span
          class="text-[11px] uppercase tracking-[0.14em] font-medium text-accent mr-2"
          >ON THIS PAGE</span
        >
        <a
          href="#detection"
          class="text-sm text-slate-600 dark:text-slate-400 hover:text-accent transition-colors"
          >Detection</a
        >
        <a
          href="#tests"
          class="text-sm text-slate-600 dark:text-slate-400 hover:text-accent transition-colors"
          >Tests</a
        >
        <a
          href="#referrals"
          class="text-sm text-slate-600 dark:text-slate-400 hover:text-accent transition-colors"
          >Referrals</a
        >
        <a
          href="#hospital"
          class="text-sm text-slate-600 dark:text-slate-400 hover:text-accent transition-colors"
          >Admissions</a
        >
        <a
          href="#followup"
          class="text-sm text-slate-600 dark:text-slate-400 hover:text-accent transition-colors"
          >Follow-up</a
        >
      </div>
    </nav>
  </section>

  <div
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 pb-12 md:pb-16 space-y-16 md:space-y-20"
  >
    <ImpactSection
      anchorId="detection"
      eyebrow="DETECTION OF CHRONIC CONDITIONS"
      title="Family physicians detect more"
      meta="28 conditions · BMC Family Practice (2021)"
      category="detection"
      items={detectionData.items}
      visibleCount={7}
      expandLabel="See all 28 conditions"
      collapseLabel={collapseLabel}
      paperUrl="https://bmcprimcare.biomedcentral.com/articles/10.1186/s12875-021-01542-5"
      paperLinkLabel="Full paper"
      columnLabels={columnLabels}
      locale={locale}
    >
      <Fragment slot="context">
        <p>
          Family physicians were more likely to detect most of the 28 chronic
          conditions analysed. The effect is strongest for conditions that
          require active suspicion: drug addiction, alcohol abuse, peripheral
          artery disease, kidney failure.
        </p>
      </Fragment>
      <Fragment slot="interpretation">
        <p>
          Detecting diseases at the right moment means being able to start
          management at earlier stages of the disease, which allows us to
          modify its course, prevent unwanted outcomes, and keep complications
          and sequelae from being established.
        </p>
      </Fragment>
    </ImpactSection>

    <ImpactSection
      anchorId="tests"
      eyebrow="LABORATORY TESTS"
      title="… and order fewer tests"
      meta="30 lab tests · BMC Family Practice (2021)"
      category="tests"
      items={testsData.items}
      visibleCount={5}
      expandLabel="See all 30 tests"
      collapseLabel={collapseLabel}
      paperUrl="https://bmcprimcare.biomedcentral.com/articles/10.1186/s12875-021-01542-5"
      paperLinkLabel="Full paper"
      columnLabels={columnLabels}
      locale={locale}
    >
      <Fragment slot="context">
        <p>
          Family physicians order fewer laboratory and imaging tests, making
          more rational use of these resources. The reductions are
          particularly significant for tests routinely ordered, such as
          hemogram, urea, uric acid, LDL cholesterol, and urinalysis.
        </p>
      </Fragment>
      <Fragment slot="interpretation">
        <p>
          Ordering fewer tests doesn't mean providing less care — it means
          making more judicious use of these resources. With better clinical
          judgment, family physicians detect more diseases while ordering
          fewer tests.
        </p>
      </Fragment>
    </ImpactSection>

    <ImpactSection
      anchorId="referrals"
      eyebrow="REFERRALS TO SECONDARY CARE"
      title="They refer with judgment"
      meta="31 specialties · BMJ Open (2022)"
      category="referrals"
      items={referralsData.items}
      visibleCount={6}
      expandLabel="See all 31 specialties"
      collapseLabel={collapseLabel}
      paperUrl="https://pmc.ncbi.nlm.nih.gov/articles/PMC8852675/pdf/bmjopen-2021-051515.pdf"
      paperLinkLabel="Full paper"
      columnLabels={columnLabels}
      locale={locale}
    >
      <Fragment slot="context">
        <p>
          The story here is more nuanced than in previous sections: family
          physicians don't simply refer less.
        </p>
      </Fragment>
      <Fragment slot="nuance">
        <p>
          Family physicians don't simply refer less; they refer more
          judiciously. For conditions that require specialized resources —
          rehabilitation, physiotherapy, eye surgery — they refer patients
          more readily, expanding access for those who truly need it. For
          clinical conditions that can be managed in primary care —
          dermatology, ambulatory orthopaedics, cardiology, pulmonology,
          endocrinology — they refer far less, keeping care at the first
          level. The net effect is increased capacity of the health system.
        </p>
      </Fragment>
      <Fragment slot="interpretation">
        <p>
          Reducing referrals doesn't congest primary care; it decompresses
          secondary care, ensuring that the patient's care happens where it
          should be.
        </p>
      </Fragment>
    </ImpactSection>

    <ImpactSection
      anchorId="hospital"
      eyebrow="HOSPITAL ADMISSIONS"
      title="They reduce admissions"
      meta="14 ambulatory-care sensitive conditions · PLOS Glob Public Health (2023)"
      category="hospital"
      items={hospitalData.items}
      visibleCount={4}
      expandLabel="See all 14 conditions"
      collapseLabel={collapseLabel}
      paperUrl="https://journals.plos.org/globalpublichealth/article?id=10.1371/journal.pgph.0000547"
      paperLinkLabel="Full paper"
      columnLabels={columnLabels}
      locale={locale}
    >
      <Fragment slot="context">
        <p>
          Patients followed by family physicians had a lower risk of
          hospitalization for the ambulatory-care sensitive conditions
          analysed (Brazilian ACSC list). The effect was observed both for
          acute conditions (pneumonia, skin infections, conditions related to
          pregnancy, childbirth, and the postpartum period) and for chronic
          conditions that, when well managed, can reduce the risk of
          exacerbation and hospital admission — asthma, heart failure, and
          angina pectoris are some examples.
        </p>
      </Fragment>
      <Fragment slot="interpretation">
        <p>
          Every admission avoided represents not only savings for the system,
          but less suffering and better quality of life. A patient whose
          asthma is well controlled is one fewer patient in the emergency
          room.
        </p>
      </Fragment>
    </ImpactSection>

    <section id="followup" class="scroll-mt-32">
      <div
        class="text-[11px] uppercase tracking-[0.14em] font-medium text-accent mb-2"
      >
        CONTINUITY OF CARE
      </div>
      <h2
        class="text-2xl md:text-3xl font-semibold tracking-[-0.025em] text-slate-900 dark:text-slate-100 mb-1.5"
      >
        Diagnosis is only one step
      </h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
        3 separate analyses
      </p>
      <p
        class="text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300 mb-10"
      >
        Diagnosing, ordering tests, or making a referral is just one step of
        care. Continuing care over time with the same physician is both a
        challenge and a duty of primary care. After making a new diagnosis,
        after referring a patient to secondary care, and after a hospital
        admission, family physicians provide more follow-up visits in each of
        these three situations. This shows how training in this specialty
        prepares physicians to deliver continuity of care to their patients.
      </p>
      <FollowupTables locale="en" />
    </section>

    <section>
      <div
        class="text-[11px] uppercase tracking-[0.14em] font-medium text-accent mb-2"
      >
        METHODS AND LIMITATIONS
      </div>
      <div
        class="space-y-4 text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300 mt-4"
      >
        <p>
          Risk ratios were estimated using multilevel binomial models
          adjusted for age, sex, Charlson comorbidity index, neighbourhood
          social development index, and time. Each visit was treated as a
          binary event nested within the patient, and within the physician
          or family health team, depending on the outcome.
        </p>
        <p>
          The absolute numbers projected by the bar above use the World
          Health Organization's <a
            href="https://www.who.int/teams/environment-climate-change-and-health/air-quality-and-health/videos/mosaic/burden-of-disease/population-attributable-fraction"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:underline"
            >Population Attributable Fraction (PAF)</a
          > formula, applied to the observed baseline for each event.
        </p>
        <p>
          Limitations: the data reflect the specific context of Rio de
          Janeiro between 2013–2018, with the particular structure of the
          city's public primary care system. Immediate generalization to
          other contexts requires caution. Local variations in structure,
          resources, and medical training affect the transferability of the
          findings.
        </p>
      </div>
    </section>

    <section>
      <div
        class="text-[11px] uppercase tracking-[0.14em] font-medium text-accent mb-4"
      >
        REFERENCES
      </div>
      <ImpactReferences locale="en" />
    </section>

    <section
      class="border-t-[0.5px] border-slate-200 dark:border-slate-700 pt-8"
    >
      <p
        class="text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300 mb-4"
      >
        See how that proportion translates into savings for the health
        system.
      </p>
      <a
        href="/en/simulator"
        class="inline-flex items-center gap-2 bg-accent text-white dark:text-slate-900 text-sm font-medium py-2.5 px-5 rounded-md hover:opacity-90 transition-opacity"
      >
        Go to the simulator →
      </a>
    </section>
  </div>
</Base>

<script>
  import {
    calc,
    formatNumber,
    formatDelta,
    getChangeClass,
    type ImpactCategoryKey,
  } from "../../scripts/impact-calc";

  const locale: "pt-BR" | "en-US" =
    document.documentElement.lang === "en" ? "en-US" : "pt-BR";

  const FAVORABLE = ["text-accent"];
  const UNFAVORABLE = ["text-amber-600", "dark:text-amber-400"];
  const NEUTRAL = ["text-slate-500", "dark:text-slate-500"];
  const ALL_TONE = [...FAVORABLE, ...UNFAVORABLE, ...NEUTRAL];

  function applyTone(el: Element, klass: "favorable" | "unfavorable" | "neutral") {
    el.classList.remove(...ALL_TONE);
    if (klass === "favorable") el.classList.add(...FAVORABLE);
    else if (klass === "unfavorable") el.classList.add(...UNFAVORABLE);
    else el.classList.add(...NEUTRAL);
  }

  function recalculateAll(pMF: number) {
    const aggregates: Record<ImpactCategoryKey, number> = {
      detection: 0,
      tests: 0,
      referrals: 0,
      hospital: 0,
    };

    document.querySelectorAll<HTMLTableRowElement>("tr[data-rr]").forEach(
      (row) => {
        const rr = parseFloat(row.getAttribute("data-rr") ?? "NaN");
        const pop = parseFloat(row.getAttribute("data-pop") ?? "NaN");
        const base = parseFloat(row.getAttribute("data-base") ?? "NaN");
        const category = row.getAttribute("data-category") as ImpactCategoryKey;
        if (!isFinite(rr) || !isFinite(pop) || !isFinite(base) || !category)
          return;

        const [newValue, delta] = calc(base, rr, pMF, pop);

        const deltaCell = row.querySelector<HTMLElement>("[data-delta-display]");
        const newValueCell = row.querySelector<HTMLElement>(
          "[data-new-value-display]"
        );
        if (deltaCell) {
          deltaCell.textContent = formatDelta(delta, locale);
          applyTone(deltaCell, getChangeClass(category, delta));
        }
        if (newValueCell) {
          newValueCell.textContent = formatNumber(newValue, locale);
        }

        aggregates[category] += delta;
      }
    );

    (Object.keys(aggregates) as ImpactCategoryKey[]).forEach((cat) => {
      const el = document.querySelector<HTMLElement>(
        `[data-impact-value="${cat}"]`
      );
      if (!el) return;
      const totalDelta = aggregates[cat];
      el.textContent = formatDelta(totalDelta, locale);
      applyTone(el, getChangeClass(cat, totalDelta));
    });
  }

  document.addEventListener("impact:proportion-change", ((e: CustomEvent) => {
    recalculateAll(e.detail.pMF);
  }) as EventListener);

  recalculateAll(0.336);
</script>
