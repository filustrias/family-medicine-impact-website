---
interface Props {
  labels: {
    generalists: string;
    familyPhysicians: string;
    instruction?: string;
    reset: string;
  };
}

const { labels } = Astro.props;
---

<div
  class="sticky top-0 z-40 backdrop-blur-sm bg-white/90 dark:bg-slate-950/90 border-b-[0.5px] border-slate-200 dark:border-slate-700"
>
  <div class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 py-3 md:py-4">
    <div
      class="flex items-center justify-between gap-3 text-xs md:text-sm text-slate-600 dark:text-slate-400 mb-2 tabular-nums"
    >
      <span class="truncate">
        <span data-bar-generalists>66.4</span>% <span class="hidden sm:inline">{labels.generalists}</span>
      </span>
      <span
        data-bar-percent
        class="text-base md:text-lg font-semibold text-accent shrink-0"
      >33.6%</span>
      <span class="truncate text-right">
        <span class="hidden sm:inline">{labels.familyPhysicians}</span> <span data-bar-mf>33.6</span>%
      </span>
    </div>
    <input
      data-bar-slider
      type="range"
      min="0"
      max="100"
      value="33.6"
      step="0.1"
      role="slider"
      aria-label={labels.instruction ?? labels.familyPhysicians}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="33.6"
      class="w-full accent-[var(--color-accent)] cursor-pointer"
    />
    <div
      class="mt-1.5 flex items-center justify-between gap-3 text-[11px] text-slate-500 dark:text-slate-500"
    >
      <span class="truncate">{labels.instruction ?? ""}</span>
      <button
        data-bar-reset
        type="button"
        aria-label={labels.reset}
        title={labels.reset}
        class="inline-flex items-center gap-1 hover:text-accent transition-colors cursor-pointer shrink-0"
      >
        <span aria-hidden="true">↺</span> <span>{labels.reset}</span>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const slider = document.querySelector<HTMLInputElement>("[data-bar-slider]");
    const mfLabel = document.querySelector<HTMLElement>("[data-bar-mf]");
    const genLabel = document.querySelector<HTMLElement>(
      "[data-bar-generalists]"
    );
    const pctLabel = document.querySelector<HTMLElement>("[data-bar-percent]");
    const resetBtn = document.querySelector<HTMLButtonElement>(
      "[data-bar-reset]"
    );
    if (!slider || !mfLabel || !genLabel || !pctLabel) return;

    function update() {
      const v = parseFloat(slider!.value);
      const pMF = v / 100;
      mfLabel!.textContent = v.toFixed(1);
      genLabel!.textContent = (100 - v).toFixed(1);
      pctLabel!.textContent = v.toFixed(1) + "%";
      slider!.setAttribute("aria-valuenow", v.toFixed(1));
      document.dispatchEvent(
        new CustomEvent("impact:proportion-change", { detail: { pMF } })
      );
    }

    slider.addEventListener("input", update);
    resetBtn?.addEventListener("click", () => {
      slider!.value = "33.6";
      update();
    });
  })();
</script>
