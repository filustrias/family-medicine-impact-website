---
import { Icon } from "astro-icon/components";

interface Props {
  lang?: string;
}

const { lang = "pt" } = Astro.props;

const dict = {
  pt: {
    nav: {
      home: { label: "Início", href: "/" },
      impact: { label: "Impacto", href: "/impacto" },
      simulate: { label: "Simulador", href: "/simulador" },
      projects: { label: "Projetos", href: "/projetos" },
      about: { label: "Sobre", href: "/sobre" },
    },
    other: { code: "EN", aria: "Switch to English" },
    themeAria: "Alternar tema claro/escuro",
    menuAria: "Abrir menu",
  },
  en: {
    nav: {
      home: { label: "Home", href: "/en/" },
      impact: { label: "Impact", href: "/en/impact" },
      simulate: { label: "Simulator", href: "/en/simulator" },
      projects: { label: "Projects", href: "/en/projects" },
      about: { label: "About", href: "/en/about" },
    },
    other: { code: "PT", aria: "Mudar para português" },
    themeAria: "Toggle light/dark theme",
    menuAria: "Open menu",
  },
};

const t = dict[lang as "pt" | "en"] ?? dict.pt;
const brandHref = lang === "en" ? "/en/" : "/";

// Bidirectional path map (PT <-> EN). Preserves the current page when switching
// languages.
const localePairs: Array<[string, string]> = [
  ["/", "/en/"],
  ["/sobre", "/en/about"],
  ["/projetos", "/en/projects"],
  ["/impacto", "/en/impact"],
  ["/impacto-visual", "/en/visual-impact"],
  ["/simulador", "/en/simulator"],
];
const ptToEn = new Map(localePairs);
const enToPt = new Map(localePairs.map(([pt, en]) => [en, pt]));

function normalizePath(p: string): string {
  if (p === "/" || p === "/en/") return p;
  return p.endsWith("/") ? p.slice(0, -1) : p;
}

const currentPath = normalizePath(Astro.url.pathname);
const otherHref =
  lang === "en"
    ? enToPt.get(currentPath) ?? "/"
    : ptToEn.get(currentPath) ?? "/en/";
---

<header class="border-b-[0.5px] border-slate-200 dark:border-slate-700">
  <div
    class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 py-4 flex items-center justify-between gap-4"
  >
    <a href={brandHref} class="flex items-center gap-2 shrink-0">
      <span class="w-2 h-2 rounded-full bg-accent inline-block" aria-hidden="true"></span>
      <span class="text-sm font-medium text-slate-900 dark:text-slate-100"
        >family-medicine-impact</span
      >
    </a>

    <nav
      class="hidden md:flex items-center gap-6 text-sm text-slate-600 dark:text-slate-400"
      aria-label="Primary"
    >
      <a href={t.nav.home.href} class="hover:text-accent transition-colors">{t.nav.home.label}</a>
      <a href={t.nav.impact.href} class="hover:text-accent transition-colors">{t.nav.impact.label}</a>
      <a href={t.nav.simulate.href} class="hover:text-accent transition-colors">{t.nav.simulate.label}</a>
      <a href={t.nav.projects.href} class="hover:text-accent transition-colors">{t.nav.projects.label}</a>
      <a href={t.nav.about.href} class="hover:text-accent transition-colors">{t.nav.about.label}</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={otherHref}
        aria-label={t.other.aria}
        class="text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-accent border-l-[0.5px] border-slate-200 dark:border-slate-700 pl-3 transition-colors"
      >
        {t.other.code}
      </a>
      <button
        id="atlas-theme-toggle"
        type="button"
        aria-label={t.themeAria}
        class="text-slate-600 dark:text-slate-400 hover:text-accent transition-colors flex items-center"
      >
        <Icon name="lucide:sun" class="w-5 h-5 hidden dark:inline-block" aria-hidden="true" />
        <Icon name="lucide:moon" class="w-5 h-5 inline-block dark:hidden" aria-hidden="true" />
      </button>
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label={t.menuAria}
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="md:hidden text-slate-600 dark:text-slate-400 hover:text-accent transition-colors flex items-center"
      >
        <Icon name="lucide:menu" class="w-5 h-5" aria-hidden="true" data-menu-open />
        <Icon name="lucide:x" class="w-5 h-5 hidden" aria-hidden="true" data-menu-close />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary mobile"
    class="md:hidden hidden border-t-[0.5px] border-slate-200 dark:border-slate-700"
  >
    <div
      class="max-w-4xl mx-auto px-4 py-3 flex flex-col text-sm text-slate-600 dark:text-slate-400"
    >
      <a
        href={t.nav.home.href}
        class="py-2 hover:text-accent transition-colors"
        >{t.nav.home.label}</a
      >
      <a
        href={t.nav.impact.href}
        class="py-2 hover:text-accent transition-colors"
        >{t.nav.impact.label}</a
      >
      <a
        href={t.nav.simulate.href}
        class="py-2 hover:text-accent transition-colors"
        >{t.nav.simulate.label}</a
      >
      <a
        href={t.nav.projects.href}
        class="py-2 hover:text-accent transition-colors"
        >{t.nav.projects.label}</a
      >
      <a
        href={t.nav.about.href}
        class="py-2 hover:text-accent transition-colors"
        >{t.nav.about.label}</a
      >
    </div>
  </nav>
</header>

<script>
  const themeBtn = document.getElementById("atlas-theme-toggle");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("atlas-theme", isDark ? "dark" : "light");
      } catch (_) {
        /* localStorage unavailable */
      }
    });
  }

  const mobileBtn = document.getElementById("mobile-nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  if (mobileBtn && mobileNav) {
    const iconOpen = mobileBtn.querySelector<HTMLElement>("[data-menu-open]");
    const iconClose = mobileBtn.querySelector<HTMLElement>("[data-menu-close]");

    function setOpen(open: boolean) {
      mobileNav!.classList.toggle("hidden", !open);
      mobileBtn!.setAttribute("aria-expanded", String(open));
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    }

    mobileBtn.addEventListener("click", () => {
      const isHidden = mobileNav.classList.contains("hidden");
      setOpen(isHidden);
    });

    // Close menu when any link inside is clicked
    mobileNav.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });
  }
</script>
