---

<div class="space-y-14">
  <div>
    <h3
      class="text-xl md:text-2xl font-semibold tracking-[-0.025em] text-slate-900 dark:text-slate-100 mb-4"
    >
      {t.diagnosisTitle}
    </h3>
    <div
      class="space-y-4 text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300 mb-6"
    >
      {t.diagnosisParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-[0.5px] border-slate-200 dark:border-slate-700">
            <th
              class="text-left py-2 pr-3 text-[11px] uppercase tracking-[0.14em] font-medium text-slate-500 dark:text-slate-500"
              >{t.diagnosisHead.name}</th
            >
            <th
              class="text-right py-2 pl-3 text-[11px] uppercase tracking-[0.14em] font-medium text-slate-500 dark:text-slate-500 whitespace-nowrap"
              >{t.diagnosisHead.rr}</th
            >
          </tr>
        </thead>
        <tbody>
          {
            t.diagnosisRows.map((row) => (
              <tr class="border-b-[0.5px] border-slate-100 dark:border-slate-800 even:bg-slate-50/40 dark:even:bg-slate-900/30">
                <td class="py-2 pr-3 text-slate-700 dark:text-slate-300">
                  {row[0]}
                </td>
                <td class="py-2 pl-3 text-right text-slate-700 dark:text-slate-300 tabular-nums whitespace-nowrap">
                  {row[1]}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <div>
