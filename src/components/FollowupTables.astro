            <th
              class="text-right py-2 pl-3 text-[11px] uppercase tracking-[0.14em] font-medium text-slate-500 dark:text-slate-500 whitespace-nowrap"
              >{t.hospitalHead.c3}</th
            >
          </tr>
        </thead>
        <tbody>
          {
            t.hospitalRows.map((row) => (
              <tr class="border-b-[0.5px] border-slate-100 dark:border-slate-800 even:bg-slate-50/40 dark:even:bg-slate-900/30">
                <td class="py-2 pr-3 text-slate-700 dark:text-slate-300">
                  {row[0]}
                </td>
                <td class="py-2 px-3 text-right text-slate-700 dark:text-slate-300 tabular-nums whitespace-nowrap">
                  {row[1]}
                </td>
                <td class="py-2 px-3 text-right text-slate-700 dark:text-slate-300 tabular-nums whitespace-nowrap">
                  {row[2]}
                </td>
                <td class="py-2 pl-3 text-right text-slate-700 dark:text-slate-300 tabular-nums whitespace-nowrap">
                  {row[3]}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-slate-500 dark:text-slate-500">{t.note}</p>
  </div>
</div>
