---
interface Props {
  id: string;
  eyebrow: string;
  meta: string;
  labelledBy: string;
  hidden?: boolean;
}

const { id, eyebrow, meta, labelledBy, hidden = false } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-20"
  role="tabpanel"
  aria-labelledby={labelledBy}
  hidden={hidden}
>
  <div
    class="text-[11px] uppercase tracking-[0.14em] font-medium text-accent mb-1.5"
  >
    {eyebrow}
  </div>
  <div class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {meta}
  </div>
  <div
    class="space-y-4 text-base md:text-lg leading-relaxed text-slate-700 dark:text-slate-300"
  >
    <slot />
  </div>
</section>
