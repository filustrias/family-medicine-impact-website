---
import { Icon } from "astro-icon/components";

interface Props {
  sectionLabel: string;
  slides: string[];
  sourceText: string;
  previousLabel: string;
  nextLabel: string;
}

const { sectionLabel, slides, sourceText, previousLabel, nextLabel } =
  Astro.props;

const total = slides.length;
const formatCounter = (i: number) =>
  `${String(i + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
---

<section class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 mt-8 md:mt-12">
  <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-accent mb-3">
    {sectionLabel}
  </p>

  <div
    data-evidence-carousel
    role="region"
    aria-label={sectionLabel}
    class="bg-white dark:bg-slate-800 border-[0.5px] border-slate-200 dark:border-slate-700 rounded-[10px]"
  >
    <div class="relative min-h-[130px]">
      {
        slides.map((phrase, i) => (
          <div
            data-slide
            aria-hidden={i === 0 ? "false" : "true"}
            class="absolute inset-0 p-6 md:p-7 flex items-start gap-6 transition-opacity duration-[600ms] ease-out"
            style={`opacity: ${i === 0 ? 1 : 0};`}
          >
            <span class="text-[11px] font-medium tracking-[0.16em] text-accent min-w-[60px] pt-1 whitespace-nowrap">
              {formatCounter(i)}
            </span>
            <p class="text-[17px] font-medium leading-[1.45] text-slate-900 dark:text-slate-100">
              {phrase}
            </p>
          </div>
        ))
      }
    </div>

    <div
      class="flex justify-between items-center mt-4 pt-4 px-6 md:px-7 pb-4 border-t-[0.5px] border-slate-200 dark:border-slate-700"
    >
      <div class="flex items-center">
        <div class="flex items-center gap-1.5">
          {
            slides.map((_, i) => (
              <button
                type="button"
                data-dot
                data-slide-index={i}
                aria-label={`Slide ${i + 1}`}
                class={`h-1.5 transition-all duration-300 ${
                  i === 0
                    ? "w-[18px] rounded-[3px] bg-accent"
                    : "w-1.5 rounded-full bg-slate-300 dark:bg-slate-600"
                }`}
              />
            ))
          }
        </div>
        <span
          class="ml-3.5 text-[11px] tracking-[0.04em] text-slate-400 dark:text-slate-500"
        >
          {sourceText}
        </span>
      </div>

      <div class="flex items-center gap-1">
        <button
          type="button"
          data-prev
          aria-label={previousLabel}
          class="w-[26px] h-[26px] flex items-center justify-center rounded-full border-[0.5px] border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-accent hover:text-accent transition-colors"
        >
          <Icon name="lucide:chevron-left" class="w-3.5 h-3.5" aria-hidden="true" />
        </button>
        <button
          type="button"
          data-next
          aria-label={nextLabel}
          class="w-[26px] h-[26px] flex items-center justify-center rounded-full border-[0.5px] border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-accent hover:text-accent transition-colors"
        >
          <Icon name="lucide:chevron-right" class="w-3.5 h-3.5" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const ACTIVE = ["w-[18px]", "rounded-[3px]", "bg-accent"];
    const INACTIVE = [
      "w-1.5",
      "rounded-full",
      "bg-slate-300",
      "dark:bg-slate-600",
    ];
    const INTERVAL = 5000;

    const carousels = document.querySelectorAll<HTMLElement>(
      "[data-evidence-carousel]"
    );
    carousels.forEach(initCarousel);

    function initCarousel(root: HTMLElement) {
      const slides = Array.from(
        root.querySelectorAll<HTMLElement>("[data-slide]")
      );
      const dots = Array.from(
        root.querySelectorAll<HTMLElement>("[data-dot]")
      );
      const prevBtn = root.querySelector<HTMLElement>("[data-prev]");
      const nextBtn = root.querySelector<HTMLElement>("[data-next]");
      const total = slides.length;
      if (total === 0) return;

      let current = 0;
      let timerId: number | null = null;

      function show(index: number) {
        slides.forEach((s, i) => {
          s.style.opacity = i === index ? "1" : "0";
          s.setAttribute("aria-hidden", i === index ? "false" : "true");
        });
        dots.forEach((d, i) => {
          if (i === index) {
            d.classList.remove(...INACTIVE);
            d.classList.add(...ACTIVE);
          } else {
            d.classList.remove(...ACTIVE);
            d.classList.add(...INACTIVE);
          }
        });
        current = index;
      }

      function next() {
        show((current + 1) % total);
      }
      function prev() {
        show((current - 1 + total) % total);
      }

      function startTimer() {
        stopTimer();
        timerId = window.setInterval(next, INTERVAL);
      }
      function stopTimer() {
        if (timerId !== null) {
          clearInterval(timerId);
          timerId = null;
        }
      }
      function restart() {
        stopTimer();
        startTimer();
      }

      dots.forEach((d, i) => {
        d.addEventListener("click", () => {
          show(i);
          restart();
        });
      });
      prevBtn?.addEventListener("click", () => {
        prev();
        restart();
      });
      nextBtn?.addEventListener("click", () => {
        next();
        restart();
      });

      root.addEventListener("mouseenter", stopTimer);
      root.addEventListener("mouseleave", startTimer);

      startTimer();
    }
  })();
</script>
