---
import { Icon } from "astro-icon/components";

interface Card {
  icon: string;
  href: string;
  title: string;
  description: string;
}

interface Props {
  sectionLabel: string;
  cards: Card[];
}

const { sectionLabel, cards } = Astro.props;
---

<section class="max-w-4xl mx-auto px-4 md:px-8 lg:px-12 mt-8 md:mt-12 pb-12 md:pb-16">
  <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-accent mb-3">
    {sectionLabel}
  </p>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="block bg-white dark:bg-slate-800 border-[0.5px] border-slate-200 dark:border-slate-700 rounded-[10px] p-5 md:p-6 no-underline transition-all duration-200 hover:border-accent hover:-translate-y-px"
        >
          <Icon
            name={card.icon}
            class="w-[22px] h-[22px] text-accent"
            aria-hidden="true"
          />
          <h3 class="text-sm font-medium text-slate-900 dark:text-slate-100 mt-2 mb-1">
            {card.title}
          </h3>
          <p class="text-[12.5px] leading-relaxed text-slate-600 dark:text-slate-400">
            {card.description}
          </p>
        </a>
      ))
    }
  </div>
</section>
